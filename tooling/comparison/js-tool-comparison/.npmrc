# The repository root sets `package-lock=false`, because the root tree is
# yarn's and an accidental `npm install` there must not write a second lockfile
# beside `yarn.lock`. A corpus is the opposite: it is installed with `npm ci`,
# so its lockfile is the whole point of it.
#
# Dependabot reads `.npmrc` from the directory it updates and walks up to the
# repository root when it finds none, so without this file the root's answer
# reached here — and a bump moved `package.json` while leaving
# `package-lock.json` on the versions before it, which `npm ci` refuses to
# install. Saying it here stops the walk.
package-lock=true
