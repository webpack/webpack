/* test/configCases/css/used-exports-shake-convention-alias/style.module.css */
.foo_bar{color:red}.unused-class{color:blue}:export{usedVar:hello;unusedVar:goodbye}
/* test/configCases/css/used-exports-shake-text-default/text-shake.module.css */
.shown{color:green}.hidden{color:gray}
/* test/configCases/css/used-exports-shake-text-named/text-shake.module.css */
.shown{color:green}.hidden{color:gray}
/* test/configCases/css/used-exports-shake/styles.module.css */
.used{color:red}.unused{color:blue}:export{usedVar:hello;unusedVar:goodbye}
/* test/configCases/css/view-transitions/style.module.css */
.card{view-transition-name:cardName;view-transition-class:cardClass}.reserved{view-transition-name:none;view-transition-group:nearest}.dashed{view-transition-name:--dashedName}::view-transition-group(cardName){animation-duration:1s}::view-transition-old(cardName),::view-transition-new(cardName){animation:none}::view-transition-image-pair(*.cardClass){animation:none}
/* test/configCases/css/webpack-ignore/basic.css */
