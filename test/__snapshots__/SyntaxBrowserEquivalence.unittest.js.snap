/*! colormin: should minify lowercase color values */.t01{color:yellow}/*! colormin: should minify uppercase color values */.t02{COLOR:YELLOW}/*! colormin: should minify color values (2) */.t03{box-shadow:0 1px 3px #ffe6dc80}/*! colormin: should minify color values (3) */.t04{background:hsla(134,50%,50%,1)}/*! colormin: should minify color values (4) */.t05{text-shadow:1px 1px 2px #000}/*! colormin: should minify color values (5) */.t06{text-shadow:1px 1px 2px #fff}/*! colormin: should minify color values (6) */.t07{text-shadow:1px 1px 2px #fff}/*! colormin: should minify color values (7) */.t08{background:HSLA(134,50%,50%,1)}/*! colormin: should minify color values (8) */.t09{background:#fff}/*! colormin: should minify color values (9) */.t10{background:azure}/*! colormin: should minify color values in background gradients */.t11{background:linear-gradient(red,yellow)}/*! colormin: should minify color values in background gradients (2) */.t12{background:linear-gradient(yellow,orange),linear-gradient(black,#fff0)}/*! colormin: should minify color values in background gradients (3) */.t13{background:linear-gradient(0deg,yellow,black 40%,red)}/*! colormin: should not minify in font properties */.t14{font-family:black}/*! colormin: should make an exception for webkit tap highlight color */.t15{-webkit-tap-highlight-color:rgba(0,0,0,0)}/*! colormin: should not crash on transparent in webkit tap highlight color */.t16{-webkit-tap-highlight-color:transparent}/*! colormin: should not crash on inherit in webkit tap highlight color */.t17{-webkit-tap-highlight-color:inherit}/*! colormin: should minify color stops */.t18{background-image:-webkit-gradient(linear,50% 0%,50% 100%,color-stop(1px,#fbfbfb),color-stop(1px,#ffffff),color-stop(2px,#ececec))}/*! colormin: should not minify in lowercase calc values */.t19{width:calc(50vw - 6px + 0)}/*! colormin: should not minify in uppercase calc values */.t20{width:calc(50vw - 6px + 0)}/*! colormin: should minify hex colors without keywords */.t21{background:linear-gradient(#fff,#999) no-repeat}/*! colormin: should not mangle percentage based rgba values */.t22{color:#80808080}/*! colormin: should convert percentage based rgba values */.t23{color:#fff}/*! colormin: should handle errored cases */.t24{color:rgb(50%,23,54)}/*! colormin: should add extra spaces when converting rgb */.t25{background:linear-gradient(#323232 0%,blue 100%)}/*! webpack: space-separated rgb() */.t26{color:#323232}/*! webpack: rgb() with a slash alpha */.t27{color:#00000080}/*! webpack: rgb() alpha written as 1 */.t28{color:red}/*! webpack: transparent black is the \`transparent\` keyword */.t29{color:#0000}/*! webpack: a non-black transparent is a different value */.t30{color:#f000}/*! webpack: 8-digit hex, collapsible */.t31{color:#abcd}/*! webpack: 8-digit hex, not collapsible */.t32{color:#ffaabbce}/*! webpack: 4-digit hex */.t33{color:#abcd}/*! webpack: an id selector that looks like a hex color */#ABCDEF{color:red}/*! webpack: a hash inside a non-color function is an id reference */.t34{background:-moz-element(#Abc)}/*! webpack: a hash inside a gradient is a color */.t35{background:linear-gradient(#abc,red)}/*! webpack: -webkit-tap-highlight-color does not leak to the next declaration */.t36{-webkit-tap-highlight-color:rgba(0,0,0,0);color:#0000}/*! webpack: a \`@supports\` condition is the declaration being tested, so its
   color keeps the spelling the test asked about */@supports (color:rgba(0,0,0,0)){.t37{color:red}}/*! data: a name shorter than its 6-hex */.t38{color:sienna}/*! data: the same, from rgb() */.t39{color:orchid}/*! data: a 3-hex beats every name for that value */.t40{color:#000;background:#00f;border-color:#fff}/*! data: \`drop-shadow()\` takes a color, so its hash is one */.t41{filter:drop-shadow(2px 2px red)}/*! data: so does \`light-dark()\` */.t42{color:light-dark(red,#0f0)}/*! data: \`element()\` does not — its hash is an id reference */.t43{background:element(#Abc)}/*! data: nor does \`image-set()\`; the nested gradient is matched instead */.t44{background:image-set(linear-gradient(red,#00f) 1x)}/*! colormin: an hsl() that lands on a byte exactly */.h01{color:red;background:#00f}/*! colormin: ...whatever spelling it was written in */.h02{color:red;background:red}/*! declined: this one has to round, and that is where engines part company */.h03{color:hsl(134,50%,50%)}/*! declined: ...as does a plain grey at 50% */.h04{color:hsl(0,0%,50%)}/*! a partly transparent one takes the hex-alpha spelling, gated on the target */.h05{color:#ff000080}/*! declined: an angle unit other than \`deg\` needs its own conversion */.h06{color:hsl(0turn,100%,50%)}/*! declined: a substitution, and a saturation out of range */.h07{color:hsl(var(--h),100%,50%);background:hsl(0,150%,50%)}/*! declined: hwb() — esbuild says #00c3ff, lightningcss says #00c4ff */.h08{color:hwb(194 0% 0%)}
