/* test/configCases/css/minimize-calc/style.css */
/*! calc: a sum of one unit is that unit */.c01{width:3px}/*! calc: ...and subtraction the same way */.c02{width:6px}/*! calc: a product by a plain number */.c03{width:2px}/*! calc: ...on either side of the \`*\` */.c04{width:9pt}/*! calc: division by a plain number */.c05{width:2.5px}/*! calc: parentheses group, and the group folds first */.c06{width:9px}/*! calc: a nested calc() is the parentheses it prints as */.c07{width:6px}/*! calc: units fixed against each other are one term */.c08{width:97px}/*! calc: ...and the result takes the shortest unit equal to it */.c09{width:6pc}/*! calc: ...which is any unit of the group, not only the one it counts in */.c10a{width:11mm}/*! calc: a longer chain */.c10{width:6px}/*! calc: times convert too */.c11{transition-duration:1001ms}/*! calc: a percentage scales by a number */.c12{width:100%}/*! calc: zero keeps the shorthand's zero-unit drop */.c13{width:0}/*! calc: one angle unit adds exactly, and survives the trig \`rotate()\` runs it
   through — checked in headless Chromium against the same matrix */.c14{rotate:90deg}/*! calc: ...in whichever unit it was written */.c15{rotate:.5turn}/*! sum: a product distributes over the terms */.t01{width:calc(2em + 2px)}/*! sum: ...and so does a division */.t02{width:calc(50% + .5px)}/*! sum: terms of the same unit gather wherever they were written */.t03{width:calc(4px + 2em)}/*! sum: a negative term is the subtraction it is */.t04{width:calc(-1em + 1px)}/*! sum: ...gathering through a nested calc() as well */.t06{width:calc(3.75rem + 1.5em)}/*! kept: a zero term stays — which units may be added to which is a type rule,
   and dropping it would make an expression the engine rejects into one it takes */.t05{width:calc(1px + 0deg)}/*! declined: two units that only layout can add */.d01{width:calc(100% - 10px)}/*! declined: a relative unit against an absolute one */.d02{width:calc(1em + 2px)}/*! declined: a substitution could be anything */.d03{width:calc(var(--x) + 1px)}/*! declined: mixed base types are invalid CSS, and folding would make them valid */.d04{width:calc(1px + 1deg)}/*! declined: division by zero is not a number */.d05{width:calc(1px/0)}/*! declined: the result would need more digits than the expression */.d06{width:calc(100%/3)}/*! declined: a math function other than calc() */.d07{width:3px}/*! declined: two angle units — only \`deg\`/\`grad\`/\`turn\` convert exactly, and
   nothing converts them here, so they stay two terms */.d08{rotate:calc(45deg + .125turn)}/*! unwrap: a positive dimension means the same bare */.u01{width:3px}/*! unwrap: a percentage too — no \`<integer>\` carries one */.u02{width:50%}/*! unwrap: an integer is an integer either way */.u03{z-index:2}/*! unwrap: a fraction is safe where the property takes no \`<integer>\` */.u04{opacity:.5}/*! unwrap: ...line-height likewise */.u05{line-height:1.5}/*! kept: \`z-index: 1.5\` is dropped, \`calc(1.5)\` rounds to 2 */.u06{z-index:calc(1.5)}/*! kept: \`width: -5px\` is dropped, \`calc(-5px)\` clamps to 0 */.u07{width:calc(-5px)}/*! kept: a negative stays wrapped whatever the property */.u08{margin-left:calc(-5px)}/*! kept: \`width: calc(0)\` is a number and dropped, \`width: 0\` is a length */.u09{width:calc(0)}/*! kept: a shorthand reaches \`<integer>\` through its longhands — \`columns: 1.5\`
   is dropped, \`calc(1.5)\` rounds to 2 columns */.u10{columns:calc(1.5)}/*! ...beside the other value it sets */.u11{columns:calc(1.5) 20em}/*! unwrap: an integer through that same longhand is still an integer */.u12{columns:2}/*! declined: a \`@supports\` condition is the syntax being tested */@supports (width:calc(1px + 2px)){.s01{color:red}}/*! declined: a custom property hands its text back through getPropertyValue() */.s02{--gap:calc(1px + 2px)}/*! math: the smallest of a list of one unit */.m01{width:1px}/*! math: ...and the largest */.m02{width:2px}/*! math: however many arguments the grammar allows */.m03{width:1px}/*! math: units fixed against each other compare too, then take the shortest */.m04{width:6pc}/*! math: clamp() is the middle one */.m05{width:3px}/*! math: ...and the lower bound wins a contradictory pair (CSS Values 4 §10.4) */.m06{width:4px}/*! math: a nested calc() has already folded by the time this runs */.m07{width:2px}/*! math: times compare */.m08{transition-duration:1s}/*! math: so do plain numbers */.m09{opacity:.5}/*! declined: a percentage basis can be negative (background-position against an
   oversized image), and picking the smaller of two depends on that sign */.n01{width:min(50%,60%)}/*! declined: only layout knows which is smaller */.n02{width:min(1em,2px)}/*! declined: a substitution could be anything */.n03{width:min(var(--x),1px)}/*! declined: clamp() takes exactly three */.n04{width:clamp(1px,2px)}/*! declined: calc-size() leads with a basis, which is an expression this does
   not evaluate, so it is the one math function with no arity to read */.n05{width:calc-size(auto,size)}/*! declined: an irrational root is not a value a stylesheet can hold */.n06{width:calc(sqrt(2)*1px)}/*! declined: ...nor a power that does not multiply back */.n07{width:calc(pow(2,.5)*1px)}/*! kept: a negative folds but keeps the parentheses */.n08{width:calc(-5px)}/*! math: abs() drops the sign */.a01{width:5px}/*! math: ...and leaves a positive alone */.a02{width:5px}/*! math: sign() is the one that changes the unit — a sign is a number */.a03{z-index:1}/*! math: ...and a negative one keeps its parentheses */.a04{z-index:calc(-1)}/*! math: hypot() where the root is exact */.a05{width:5px}/*! math: ...however many arguments, and in whichever unit */.a06{width:10px}/*! math: ...including units fixed against each other */.a07{width:5in}/*! declined: hypot() is irrational for most inputs */.a08{width:hypot(1px,1px)}/*! declined: abs() of a percentage depends on the basis sign */.a09{width:abs(-50%)}/*! math: a relative unit still has a known sign — every length unit scales by
   a positive factor, so abs() only has to drop the minus */.a10{width:1em}/*! stepped: round() to the nearest step, a tie going toward positive infinity */.p01{margin-left:6px}/*! stepped: ...and each of the three named strategies */.p02{margin-left:6px}/*! stepped: down is the floor, so a negative goes further from zero */.p03{margin-left:calc(-6px)}/*! stepped: to-zero truncates instead */.p04{margin-left:4px}/*! stepped: nearest may be named explicitly */.p05{margin-left:6px}/*! stepped: mod() takes the divisor's sign */.p06{margin-left:2px}/*! stepped: rem() takes the dividend's */.p07{margin-left:calc(-1px)}/*! stepped: ...which is the difference between them */.p08{margin-left:calc(-2px)}/*! declined: exactly on a step is where engines part company — Chromium reads
   \`round(down,10cm,2cm)\` as \`8cm\` and \`mod(10px,-2px)\` as \`-2px\`, both a whole
   step off the exact answer */.q01{margin-left:round(4px,2px)}/*! declined: ...the same boundary for mod() */.q02{margin-left:mod(10px,-2px)}/*! declined: ...and for rem() */.q03{margin-left:rem(10px,2px)}/*! declined: a zero step is NaN, which engines render differently */.q04{margin-left:round(5px,0px)}/*! declined: a negative step is not reasoned about */.q05{margin-left:round(5px,-2px)}/*! declined: two units only layout can compare */.q06{margin-left:round(5em,2px)}/*! kept as written: a unit rewrite that holds anywhere else does not hold in a
   step function, so the arguments keep the unit they were given */.q07{margin-left:round(down,4.5cm,1.5cm)}/*! exact: a root that squares back */.e01{width:1.5px}/*! exact: a whole power, multiplied out */.e02{width:8px}/*! exact: ...including a negative exponent */.e03{width:.25px}/*! exact: a logarithm that lands on a whole power of its base */.e04{width:3px}/*! exact: ...and a base of zero is one such, since \`ln(1)/ln(0)\` is \`-0\` and
   \`0\` to that power is the \`1\` it came from */.e04a{width:0}/*! exact: e to the zero */.e05{width:1px}/*! trig: a quarter turn, in whichever unit spells one */.e06{width:1px}/*! trig: ...and the same angle written as a turn */.e07{width:1px}/*! trig: a half turn is where cosine is negative, so it keeps its parentheses */.e08{width:calc(-1px)}/*! trig: tangent is rational an eighth turn apart, where sine and cosine are not */.e09{width:1px}/*! trig: the inverse functions answer with an angle, in degrees */.e10{rotate:90deg}/*! trig: ...and atan2() reads a ratio, so two lengths answer the same way */.e11{rotate:135deg}/*! exact: a folded operand of an outer expression is printed bare — no property
   judges it in here, which is what lets the outer fold go on */.e12{width:2px}/*! declined: sine is irrational an odd eighth turn from zero */.f01{width:calc(sin(30deg)*1px)}/*! declined: ...and tangent has an asymptote on the odd quarters */.f02{width:calc(tan(90deg)*1px)}/*! declined: a radian is a whole number of eighth turns only at zero */.f03{width:calc(cos(1rad)*1px)}/*! declined: \`e\` is not a double, so no other power of it can be written down */.f04{width:calc(exp(1)*1px)}/*! declined: a base of one makes the quotient \`0/0\`, which is not a number */.f04a{width:calc(log(1,1)*1px)}/*! declined: ...and a negative base has no logarithm at all */.f04b{width:calc(log(1,-2)*1px)}/*! declined: the inverse functions answer with a whole number of degrees at
   three arguments only */.f05{rotate:asin(.5)}/*! declined: a fold inside a stepped function would print the shortest unit,
   which is the rewrite that function's own arguments refuse */.q08{margin-left:round(down,calc(4.5cm),calc(1.5cm))}/*! declined: ...including another stepped function */.q09{margin-left:round(down,round(down,10cm,3cm),1cm)}
