<!-- test/configCases/html/style-attribute/page.html -->
<!doctype html><html><head><title>Style Attribute Test</title></head><body>
<div style=color:red;background:url(./pixel.png)>Single url</div>
<p style=color:blue>No url here — left untouched</p>
<span style='background-image:image-set(\\"./pixel.png\\" 1x)'>image-set</span>
<section style=background:url(./pixel.png),url(./pixel.png)>Multiple urls</section>
<div style=\\"background: url(./pixel&#46;png);\\">Entity in url</div>
<div style=\\"--quote: '&quot;'; background: url(./pixel.png);\\">Entity round-trip</div>
<div style=\\"background: &#117;rl(./pixel.png);\\">Entity-obfuscated url()</div>
<div style=\\"\\">Empty style — left untouched</div>


</body></html>
<!-- test/configCases/html/style-tag-context/sub/page.html -->
<!doctype html><html><head><title>Context Test</title><style>.bg{background:url(./pixel.png)}</style></head><body>

</body></html>
<!-- test/configCases/html/style-tag-no-css/page.html -->
<!doctype html><html><head><title>No CSS Test</title><style>body{color:red}</style></head><body>
<p>Hi</p>


</body></html>
<!-- test/configCases/html/style-tag/page.html -->
<!doctype html><html><head><title>Style Tag Test</title><style>body{color:red}.foo{background:url(./pixel.png)}</style><style type=text/css>.bar{color:blue}</style><style type=text/foo>
this stays
</style><style>.baz{color:green}.qux:before{content:\\"café →\\"}</style></head><body>
<p>Hi</p>


</body></html>
<!-- test/configCases/html/stylesheet-entry-runtime-chunk/page.html -->
<!doctype html><html><head><title>Stylesheet entry + runtimeChunk</title><link rel=stylesheet href=./style.css></head><body>
<h1>Hello</h1>


</body></html>
<!-- test/configCases/html/svg-legacy-references/page.html -->
<!doctype html><html><head><title>Legacy SVG references</title></head><body>
<svg xmlns=http://www.w3.org/2000/svg>
	<font><font-face><font-face-src><font-face-uri xlink:href=./font.ttf /></font-face-src></font-face></font>
	<cursor xlink:href=./cur.png />
	<text><altGlyph xlink:href=./ref.svg#g>x</altGlyph></text>
