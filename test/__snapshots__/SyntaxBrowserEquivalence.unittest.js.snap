/*! the keyword stays a keyword */.t01{background-color:#0000}/*! ...and the function stays the keyword, which every engine reads */.t02{background-color:#0000}/*! ...including inside a gradient */.t03{background-image:linear-gradient(red,#0000)}/*! an opaque color is not gated: it has no alpha to spell */.t04{color:#000}/*! a source hex with alpha is the author's own, and is only shortened */.t05{color:#0000}/*! a partly transparent color keeps its function: the hex would need the alpha */.t08{color:#00000080}/*! ...whatever the channels are */.t09{color:#f003}/*! rounding and unit conversion are not gated — no engine reads one and not the
   other, so they apply here too */.t10{width:1pc;height:33.3333%}/*! a media feature keeps the \`min-\`/\`max-\` spelling every engine reads */@media (width>=1200px){.t06{color:red}}/*! ...at any nesting depth */@media ((width>=1px) and (height<=2px)){.t07{color:red}}/*! the \`inset\` shorthand is newer than the four longhands it merges */.t11{inset:1px 2px}/*! ...unlike \`margin\`, whose shorthand is as old as its longhands */.t12{margin:1px 2px}/*! ...and a source \`inset\` is the author's own, so it still collapses */.t13{inset:1px}
