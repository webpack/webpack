exports[`CSS syntax — invariants minimize-transforms-off prints {"mode":"minify"} 1`] = `"/*! comments: at \`\\"all\\"\` an inert comment is kept, not just this banner *//*! shortenColors: the hex is not shortened */.t01{color:#fff}/*! reduceFunctions: the calc is not folded and the transform names both axes */.t03{width:3px;transform:translate(1px)}/*! shortenNumbers: the leading zero and the trailing fraction stay */.t05{opacity:1;width:.5px}/*! normalizeQuotes: the string keeps the quote it was written with */.t06{content:\\"x\\"}/*! removeDeadRules: the second declaration of a property keeps the first */.t07{color:red}/*! shortenSelectors: the list is neither deduplicated nor ordered */.t08,.t09{color:red}/*! shortenValues: the repeated box value is not collapsed */.t10{margin:1px}/*! shortenMediaQueries: the feature keeps its \`min-\` spelling */@media (width>=100px){.t11{color:red}}/*! mergeRules: two rules printing the same block stay two */.t12,.t13{color:red}/*! mergeLonghands: the four sides stay four declarations */.t14{margin:1px 2px}/*! reorderDeclarations: the declarations keep the order they were written in */.t12{color:red;display:block}"`;

exports[`CSS syntax — invariants minimize-transforms-off prints {"print":"cssMinify","environment":{"browsers":["and_chr 156","and_ff 159","and_qq 14.9","and_uc 15.5","android 156","chrome 156","chrome 155","chrome 154","chrome 153","chrome 152","chrome 151","chrome 150","chrome 109","edge 155","edge 154","edge 153","edge 152","firefox 159","firefox 158","firefox 156","firefox 155","firefox 153","ios_saf 27.0","ios_saf 26.6","ios_saf 26.5","ios_saf 18.5-18.7","kaios 3.0-3.1","kaios 2.5","op_mini all","op_mob 80","opera 135","opera 134","safari 27","safari 26.6","samsung 30","samsung 29"],"vendorPrefixes":true},"svg":false,"extractComments":false,"comments":"all","lowerUnsupported":false,"mergeLonghands":false,"mergeRules":false,"normalizeQuotes":false,"reduceFunctions":false,"removeDeadRules":false,"reorderDeclarations":false,"shortenColors":false,"shortenMediaQueries":false,"shortenNumbers":false,"shortenSelectors":false,"shortenValues":false} 1`] = `
"@charset \\"UTF-8\\";/* Every \`optimization.minimize.css\` transform switch is off here, so each rule
   below keeps what the transform named in its comment would have rewritten —
   this comment among them. Whitespace still goes: collapsing it is not one of
