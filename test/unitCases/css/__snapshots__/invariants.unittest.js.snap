exports[`CSS syntax — invariants minimize-rewrite-custom-properties prints {"mode":"minify"} 1`] = `"/*! a six-digit hex shortens to three */.t01{--a:#ffffff}/*! an eight-digit hex shortens to four */.t02{--b:#ffffff00}/*! a leading zero goes */.t03{--c:0.5rem}/*! a color function becomes the hex it names */.t04{--d:rgba(0,0,0,0.15)}/*! every layer of a multi-value list is reached */.t05{--e:0px 0px 0px 2px #ffffffcc}/*! and so is a token nested in a function */.t06{--f:max(1px,0.0625rem)}/*! a substitution's fallback is the property's value, so it shortens too */.t07{--g:var(--a,#ffffff)}/*! but a hash a worklet reads is not known to be a color */.t07b{--g2:paint(w,#ffffff)}/*! the empty value a var() fallback reads survives */.t08{--h:}/*! a kept comment still stands between two tokens */.t09{--i:1px /*! kept */ 2px}/*! a normal declaration is unaffected by the option either way */.t10{color:#fff}/*! lightningcss custom_properties: an empty value, in each spelling */.u01,.u02{--test:}/*! lightningcss custom_properties: whitespace around a lone token */.u03,.u04,.u05,.u06{--test:foo}/*! lightningcss custom_properties: a var() fallback carrying a length */.u07{--test:var(--foo,20px)}/*! lightningcss custom_properties: two of them across a comma */.u08{transition:var(--foo,20px),var(--bar,40px)}/*! lightningcss custom_properties: substitutions side by side */.u09{background:var(--color)var(--image)}/*! lightningcss custom_properties: a color function in a fallback */.u10{color:var(--color,#ff0)}/*! lightningcss custom_properties: a hex in a fallback */.u11{color:var(--color,#ff0)}/*! lightningcss custom_properties: a fallback that is itself substituted */.u12{color:var(--color,rgb(var(--red),var(--green),0))}/*! lightningcss custom_properties: a time already at its shortest */.u13{--test:.5s}/*! lightningcss custom_properties: an escaped \`/\` in the property name */.u14{--theme-sizes-1\\\\/12:2}/*! lightningcss custom_properties: a zero keeps its unit, the value being opaque */.u15{--test:0px}/*! lightningcss custom_properties: attr() with a type, and with a fallback */.u16{background-color:attr(data-color type(<color>))}.u17{width:attr(data-width type(<length>),100px)}/*! a named color stays as authored, hex being invalid where the name is not */.v01{--c:white}.v02{--c:black}.v03{--c:rebeccapurple}/*! and the same name in a real color property does shorten */.v04{color:#fff}/*! a fragment keeps every digit it was written with */.w01{--u:url(#fff)}.w02{--u:url(#ffffff)}/*! a quoted value is text, hex-shaped or not */.w03{--s:\\"#fff\\"}.w04{--s:\\"0.50\\"}/*! a math operator between two substitutions */.x01{--inner:calc(var(--radius) - var(--width))}/*! ...with the right operand parenthesised */.x02{--inner-parens:calc(var(--radius) - (var(--width)))}/*! ...and outside a math function, where a substitution can still carry it in */.x03{--tail:(10px) - (4px)}"`;

