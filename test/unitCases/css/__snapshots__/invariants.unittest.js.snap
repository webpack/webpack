exports[`CSS syntax — invariants minimize-environment prints {"mode":"minify"} 1`] = `
"/*! the keyword stays a keyword */.t01{background-color:#0000}/*! ...and the function stays the keyword, which every engine reads */.t02{background-color:#0000}/*! ...including inside a gradient */.t03{background-image:linear-gradient(red,#0000)}/*! an opaque color is not gated: it has no alpha to spell */.t04{color:#000}/*! ...and a source hex with alpha is written as the color the target reads */.t05{color:#0000}/*! a partly transparent color keeps its function: the hex would need the alpha */.t08{color:#00000080}/*! ...whatever the channels are */.t09{color:#f003}/*! rounding and unit conversion are not gated — no engine reads one and not the
   other, so they apply here too */.t10{width:16px;height:33.3333333%}/*! a media feature keeps the \`min-\`/\`max-\` spelling every engine reads */@media (width>=1200px){.t06{color:red}}/*! ...at any nesting depth */@media ((width>=1px) and (height<=2px)){.t07{color:red}}/*! the \`inset\` shorthand is newer than the four longhands it merges */.t11{inset:1px 2px}/*! ...unlike \`margin\`, whose shorthand is as old as its longhands */.t12{margin:1px 2px}/*! ...and a source \`inset\` is written as the four longhands it sets */.t13{inset:1px}/*! a two-position color stop is CSS Images 4, so the two stops stay */.t14{background-image:linear-gradient(red 0% 50%,blue)}/*! ...unlike the last stop's position, which CSS Images 3's own fix-up already
   puts there */.t15{background-image:linear-gradient(red,blue)}/*! the \`place-*\` shorthands are newer than the pairs they merge */.t16{place-items:center end}.t17{place-self:center}.t18{place-content:center end}/*! ...unlike \`gap\`, whose shorthand is as old as its longhands */.t19{gap:1px 2px}/*! ...and a source \`place-items\` is written as the two longhands it sets */.t20{place-items:center end}/*! ...and two-value \`overflow\`, which Chrome 50 predates */.t21{overflow:hidden scroll}/*! ...while collapsing it to one value is as old as the longhands */.t22{overflow:hidden}"
`;

