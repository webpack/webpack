id#fff}}.parent{color:blue;@scope(&>.scope) to (&>.limit){& .content{color:red}}}article{color:green;&{color:blue}color:red}a,b{& c{color:blue}}.foo,.foo:after,.foo:before{color:#000;@media (prefers-color-scheme:dark){&{color:#fff}}}"`;

