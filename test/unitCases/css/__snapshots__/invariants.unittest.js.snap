"/*! the keyword stays a keyword */.t01{background-color:#0000}/*! ...and the function stays the keyword, which every engine reads */.t02{background-color:#0000}/*! ...including inside a gradient */.t03{background-image:linear-gradient(red,#0000)}/*! an opaque color is not gated: it has no alpha to spell */.t04{color:#000}/*! ...and a source hex with alpha is written as the color the target reads */.t05{color:#0000}/*! a partly transparent color keeps its function: the hex would need the alpha */.t08{color:#00000080}/*! ...whatever the channels are */.t09{color:#f003}/*! rounding and unit conversion are not gated — no engine reads one and not the
   other, so they apply here too */.t10{width:16px;height:33.3333333%}/*! a media feature keeps the \`min-\`/\`max-\` spelling every engine reads */@media (width>=1200px){.t06{color:red}}/*! ...at any nesting depth */@media ((width>=1px) and (height<=2px)){.t07{color:red}}/*! the \`inset\` shorthand is newer than the four longhands it merges */.t11{inset:1px 2px}/*! ...unlike \`margin\`, whose shorthand is as old as its longhands */.t12{margin:1px 2px}/*! ...and a source \`inset\` is written as the four longhands it sets */.t13{inset:1px}/*! a two-position color stop is CSS Images 4, so the two stops stay */.t14{background-image:linear-gradient(red 0% 50%,blue)}/*! ...unlike the last stop's position, which CSS Images 3's own fix-up already
   puts there */.t15{background-image:linear-gradient(red,blue)}/*! the \`place-*\` shorthands are newer than the pairs they merge */.t16{place-items:center end}.t17{place-self:center}.t18{place-content:center end}/*! ...unlike \`gap\`, whose shorthand is as old as its longhands */.t19{gap:1px 2px}/*! ...and a source \`place-items\` is written as the two longhands it sets */.t20{place-items:center end}/*! ...and two-value \`overflow\`, which Chrome 50 predates */.t21{overflow:hidden scroll}/*! ...while collapsing it to one value is as old as the longhands */.t22{overflow:hidden}"
`;

exports[`CSS syntax — invariants minimize-environment prints {"print":"cssMinify","environment":{"browsers":["chrome 50"],"vendorPrefixes":true},"svg":false,"extractComments":false} 1`] = `
"@charset \\"UTF-8\\";/*! the keyword stays a keyword */.t01{background-color:transparent}/*! ...and the function stays the keyword, which every engine reads */.t02{background-color:transparent}/*! ...including inside a gradient */.t03{background-image:linear-gradient(red,transparent)}/*! an opaque color is not gated: it has no alpha to spell */.t04{color:#000}/*! ...and a source hex with alpha is written as the color the target reads */.t05{color:transparent}/*! a partly transparent color keeps its function: the hex would need the alpha */.t08{color:rgba(0,0,0,.5)}/*! ...whatever the channels are */.t09{color:rgba(255,0,0,.2)}/*! rounding and unit conversion are not gated — no engine reads one and not the
   other, so they apply here too */.t10{width:16px;height:33.3333333%}/*! a media feature keeps the \`min-\`/\`max-\` spelling every engine reads */@media (min-width:1200px){.t06{color:red}}/*! ...at any nesting depth */@media ((min-width:1px) and (max-height:2px)){.t07{color:red}}/*! the \`inset\` shorthand is newer than the four longhands it merges */.t11{top:1px;right:2px;bottom:1px;left:2px}/*! ...unlike \`margin\`, whose shorthand is as old as its longhands */.t12{margin:1px 2px}/*! ...and a source \`inset\` is written as the four longhands it sets */.t13{top:1px;right:1px;bottom:1px;left:1px}/*! a two-position color stop is CSS Images 4, so the two stops stay */.t14{background-image:linear-gradient(red 0%,red 50%,blue)}/*! ...unlike the last stop's position, which CSS Images 3's own fix-up already
   puts there */.t15{background-image:linear-gradient(red,blue)}/*! the \`place-*\` shorthands are newer than the pairs they merge */.t16{align-items:center;justify-items:end}.t17{align-self:center;justify-self:center}.t18{align-content:center;justify-content:end}/*! ...unlike \`gap\`, whose shorthand is as old as its longhands */.t19{gap:1px 2px}/*! ...and a source \`place-items\` is written as the two longhands it sets */.t20{align-items:center;justify-items:end}/*! ...and two-value \`overflow\`, which Chrome 50 predates */.t21{overflow-x:hidden;overflow-y:scroll}/*! ...while collapsing it to one value is as old as the longhands */.t22{overflow:hidden}"
`;

