"/*! a hex alpha, which the target reads only as \`rgba()\` */.t01{color:#7bffff80}/*! transparent black, which the keyword names in fewer bytes */.t02{color:#0000}/*! a media range, which the target reads only as \`min-\` / \`max-\` */@media (480px<=width<=768px){.t03{color:red}}/*! a shorthand the target does not have, written as its longhands */.t04{place-items:center start}.t05{overflow:hidden auto}.t06{inset:1px 2px}/*! a two-position color stop, written as the two stops it names */.t07{background-image:linear-gradient(green,red 30% 40%,pink)}/*! a multi-keyword \`display\`, written as the one keyword naming the box */.t08{display:inline flex}/*! a Lab-family color, with the color it names written before it */.t09{color:oklch(59.686% .15619 49.7694)}/*! ...and \`hwb()\`, which shipped before the Lab family */.t10{background-color:hwb(120 20% 30%)}/*! a \`color()\`, which the target reads only as the sRGB it names */.t11{color:color(a98-rgb .44091 .49971 .37408)}/*! \`system-ui\`, which the target reaches only by each platform's own name */.t12{font-family:system-ui}/*! ...and the same where the print left out the separator before the color,
   which is where the components are read back from */.t13a{text-decoration:underline#fff 2px}.t13b{text-decoration:underline#010203}.t13c{text-decoration:underline solid color-mix(in oklch,red,blue)}/*! a \`text-decoration\` naming more than its line, written as longhands */.t13{text-decoration:underline 2px dotted red}/*! a \`color-mix()\`, evaluated where every component is known */.t14{color:#706a43}/*! a relative color, resolved against the origin it names */.t15{color:#669}"
`;

