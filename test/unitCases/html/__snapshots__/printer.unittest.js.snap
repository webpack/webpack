exports[`htmlMinify — one document reaching every embedded site minifies with webpack's own minifiers when no renderer is given 1`] = `
"<!doctype html><html lang=en><head><title>   every embedded body   </title><style>.a{color:red;margin:10px}.svg{background:url(\\"data:image/svg+xml,<svg>   <rect  fill='red' />   </svg>\\")}.css{background:url(\\"data:text/css,.i {  color : #ff0000  }\\")}.html{background:url(\\"data:text/html,<div>  <!-- x -->  <p>hi</p>  </div>\\")}.json{background:url('data:application/json,{ \\"a\\" :  1 }')}.js{background:url(\\"data:text/javascript,var  a  =  1 ;\\")}.b64{background:url(data:text/css;base64,LmlubmVyIHsgIGNvbG9yIDogI2ZmMDAwMCAgfQ==)}.png{background:url(data:image/png;base64,AAAA)}</style><script type=application/json>{\\"a\\":1,\\"b\\":[1,2]}</script><script>  var  a  =  1 ;  function  f ( ) { return  a }  </script></head><body>
<p style=color:red;margin:10px onclick=\\"  f( 1 )  ;  g( 2 )  ;  h( 3 )  \\">styled</p>
<svg viewBox=\\"0 0 2 2\\">   <rect fill=red />   </svg>
<iframe srcdoc=\\"<style>.s{color:red}</style><p>   deep   \\"></iframe>
<iframe srcdoc=\\"<p>bare\\"></iframe>

</body></html>"
`;

exports[`htmlMinify — one document reaching every embedded site offers every body to a caller's renderer, and prints each answer 1`] = `
"<!doctype html><html lang=en><head><title>   every embedded body   </title><style>ANSWER(css)</style><script type=application/json>ANSWER(json)</script><script>ANSWER(javascript/script)</script></head><body>
<p style=ANSWER(css/block-contents) onclick=ANSWER(javascript/event-handler)>styled</p>
ANSWER(svg/foreign-element)
<iframe srcdoc=\\"ANSWER(html)\\"></iframe>
<iframe srcdoc=\\"ANSWER(html)\\"></iframe>

</body></html>"
`;
