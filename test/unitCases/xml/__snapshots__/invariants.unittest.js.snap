  </foreignObject><svg:foreignObject height=\\"300\\" width=\\"300\\">
    <xhtml:button formaction=\\"vbscript:msgbox(1)\\">Button</xhtml:button>
  </svg:foreignObject><custom:foreignObject srcdoc=\\"Custom data\\">Non-executable custom content</custom:foreignObject><text>Safe SVG content</text></svg>"
`;

