        <filter id=\\"filter0_dust\\" x=\\"0\\" y=\\"0\\" width=\\"18\\" height=\\"18\\" filterUnits=\\"userSpaceOnUse\\" color-interpolation-filters=\\"sRGB\\">
            <feFlood flood-opacity=\\"0\\" result=\\"BackgroundImageFix\\"/>
