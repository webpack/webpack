	</circle><circle cx=\\"12\\" cy=\\"12\\">
		<animate id=\\"b\\" attributeName=\\"r\\" begin=\\"a.begin+0.2s; a.repeat(1) ; click; 1.5s; wallclock(2003-01-01T10:00:00.5Z)\\" dur=\\"1.2s\\" values=\\"0;11\\"/>
	</circle></svg>"
`;

