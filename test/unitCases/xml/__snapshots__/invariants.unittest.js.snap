	</defs>
	<circle r=\\"5\\" fill=\\"none\\"/>
	<circle r=\\"5\\" fill=\\"red\\" fill-opacity=\\"0\\" stroke=\\"#000\\" stroke-width=\\"0\\"/>
	<g fill=\\"none\\">
