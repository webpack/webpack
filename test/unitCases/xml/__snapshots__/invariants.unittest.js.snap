exports[`XML syntax — invariants svgo-inline-styles-13 prints {"print":"xmlMinify","minimizer":{"asset":"index.svg"},"collapseWhitespace":true,"sortAttributes":true,"removeMetadata":true,"removeEditorData":true,"removeEmptyAttributes":true,"removeEmptyElements":true,"shortenColors":true,"shortenNumbers":true,"shortenPathData":true,"sortSymbols":true,"convertShapes":true,"cleanupStructure":true,"mergePaths":true,"reusePaths":true,"sortDefinitions":true,"removeUnusedNamespaces":true} 2`] = `"{}"`;

exports[`XML syntax — invariants svgo-inline-styles-13 prints {"xml":true,"mode":"minify"} 1`] = `
"<svg id=\\"test\\" xmlns=\\"http://www.w3.org/2000/svg\\" viewBox=\\"0 0 81.285 81.285\\">
    <defs>
        <style>

            /* Simple Atrules */
            @charset 'UTF-8';

            @namespace svg url(http://www.w3.org/2000/svg);

            @import url('https://fonts.googleapis.com/css?family=Roboto');

            /* Atrules with block */
            @font-face {
                font-family: SomeFont;
                src: local(\\"Some Font\\"), local(\\"SomeFont\\"), url(SomeFont.ttf);
                font-weight: bold;
            }

            @viewport {
                    zoom: 0.8;
                min-zoom: 0.4;
                max-zoom: 0.9;
            }

            @keyframes identifier {
                  0% { top:  0; }
                 50% { top: 30px; left: 20px; }
                 50% { top: 10px; }
                100% { top:  0; }
            }


            /* Nested rules */
            @page :first {
                margin: 1in;
            }

            @supports (display: flex) {
                .module { display: flex; }
            }

            @document url('http://example.com/test.html') {
                rect {
                    stroke: red;
                }
            }


            .blue {
                fill: blue;
            }
    </style>
    </defs>
    <rect width=\\"100\\" height=\\"100\\" class=\\"blue\\"/>
</svg>"
`;

