        </linearGradient>
        <text id=\\"referencedText\\">
            referenced text
        </text>
        <path id=\\"crochet\\" d=\\"...\\"/>
        <path id=\\"block\\" d=\\"...\\"/>
        <path id=\\"two\\" d=\\"...\\"/>
