"<svg xmlns=\\"http://www.w3.org/2000/svg\\">
	<defs>
		<symbol id=\\"empty\\"/>
		<symbol id=\\"full\\"><rect width=\\"1\\" height=\\"1\\"/></symbol>
		<path id=\\"dot\\" d=\\"M1 1\\"/>
		<filter id=\\"flood\\" filterUnits=\\"userSpaceOnUse\\"><feFlood/></filter>
