		<rect width=\\"1\\" height=\\"1\\" style=\\"fill:red\\"/>
		<path d=\\"M0 0h1\\" marker-end=\\"url(#m)\\"/>
	</g>
	<g fill=\\"none\\" color=\\"red\\"><circle r=\\"1\\" fill=\\"currentColor\\"/></g>
	<rect width=\\"1\\" height=\\"1\\" fill=\\"none\\" pointer-events=\\"all\\"/>
	<use href=\\"#empty\\"/>
	<use href=\\"#full\\"/>
	<use href=\\"#dot\\"/>
	<use href=\\"#dot\\" marker-start=\\"url(#m)\\"/>
	<use href=\\"#filtered\\"/>
	<text><tref/>a</text>
	<tref href=\\"#t\\"/>
	<g fill=\\"none\\" style=\\"all:initial;-x:1\\"><path d=\\"M0 0h1\\"/></g>
	<g fill=\\"none\\" style=\\"all/**/:initial;-x:1\\"><path d=\\"M0 0h1\\"/></g>
</svg>"
`;

