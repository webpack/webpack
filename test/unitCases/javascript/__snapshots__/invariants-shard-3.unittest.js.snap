exports[`JavaScript syntax — invariants one-pass-pure-conversions-arithmetic prints {"mode":"minify","compress":{"pure_conversions":false},"mangle":false} 1`] = `"function unread(a,b){return a+b,a<b,a==b,1}function bigint(a){return a+1n,2}console.log(unread(1,2),bigint(1n));function wheel(e){var x=e.x,y=e.y;if(x==null||y==null)return 0;var delta=Math.abs(y!==0?y:x),sign=y>0?-1:1;return 3*delta*sign}console.log(wheel({x:1,y:0}),wheel({x:1,y:2}),wheel({y:1}));function make(t,f,a,b){return new(f(t?a:b))}class Made{constructor(){this.k=1}}console.log(make(1,()=>Made,1,2).k);function nine(){return 9}function keep(t,x){return t?x:x=nine()}console.log(keep(1,5),keep(0,5));"`;

exports[`JavaScript syntax — invariants one-pass-pure-conversions-arithmetic prints {"mode":"minify","compress":{},"mangle":false} 1`] = `"function unread(a,b){return 1}function bigint(a){return a+1n,2}console.log(unread(),bigint(1n));function wheel(e){var x=e.x,y=e.y;return x==null||y==null?0:3*Math.abs(y!==0?y:x)*(y>0?-1:1)}console.log(wheel({x:1,y:0}),wheel({x:1,y:2}),wheel({y:1}));function make(t,f,a,b){return new(f(t?a:b))}class Made{constructor(){this.k=1}}console.log(make(1,()=>Made,1,2).k);function nine(){return 9}function keep(t,x){return t?x:x=nine()}console.log(keep(1,5),keep(0,5));"`;

exports[`JavaScript syntax — invariants one-pass-pure-conversions-arithmetic prints {"mode":"minify","compress":{}} 1`] = `"function unread(e,n){return 1}function bigint(e){return e+1n,2}console.log(unread(),bigint(1n));function wheel(e){var n=e.x,t=e.y;return n==null||t==null?0:3*Math.abs(t!==0?t:n)*(t>0?-1:1)}console.log(wheel({x:1,y:0}),wheel({x:1,y:2}),wheel({y:1}));function make(e,n,t,a){return new(n(e?t:a))}class Made{constructor(){this.k=1}}console.log(make(1,()=>Made,1,2).k);function nine(){return 9}function keep(e,n){return e?n:n=nine()}console.log(keep(1,5),keep(0,5));"`;

