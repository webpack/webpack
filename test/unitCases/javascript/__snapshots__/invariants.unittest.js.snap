exports[`JavaScript syntax — invariants one-pass-switch-default-joining-the-last-case prints {"mode":"minify","compress":{"toplevel":true},"mangle":false} 1`] = `"var log=[];function test(name){return log.push(name),name}function joins(foo){var x=1;switch(foo){case 0:case x--:}console.log(\\"joins\\",foo,x)}function empty(foo){var x=1;switch(foo){case 0:case x--:}console.log(\\"empty\\",foo,x)}function shared(foo){switch(foo){case test(\\"a\\"):case test(\\"b\\"):}console.log(\\"shared\\",foo)}function nested(flag,foo){if(flag){switch(foo){case test(\\"c\\"):}console.log(\\"nested\\",foo)}else console.log(\\"not nested\\")}function labeled(foo){{switch(foo){case test(\\"d\\"):}console.log(\\"labeled\\",foo)}}function breaks(foo){switch(foo){case test(\\"e\\"):default:if(foo>1)break;console.log(\\"breaks\\",foo)}}for(var i=0;i<3;i++)joins(i),empty(i),shared(i?\\"b\\":\\"a\\"),nested(i,\\"c\\"),labeled(i),breaks(i);console.log(log.join());"`;

