exports[`JavaScript syntax — invariants one-pass-minify-of-statement-sequences-should-print-the-known-switch-spread-and-2 prints {"mode":"minify","module":true,"compress":{},"mangle":{}} 1`] = `"function e(){return Array.prototype.slice.call(arguments)}function t(){this.items=Array.prototype.slice.call(arguments)}it(\\"should print what a spread literal holds in its place\\",()=>{expect([1,2,3]).toEqual([1,2,3]),expect({a:1,b:2,c:3}).toEqual({a:1,b:2,c:3}),expect({a:1,a:2}).toEqual({a:2}),expect(e(4,5)).toEqual([4,5]),expect(new t(6).items).toEqual([6])}),it(\\"should keep a hole a spread printing nothing follows\\",()=>{expect(2).toBe(2),expect(1).toBe(1)}),it(\\"should run what a spread holds where only the arguments of a call run\\",()=>{let e=[];e.push(\\"a\\"),e.push(\\"b\\"),expect(e).toEqual([\\"a\\",\\"b\\"])}),it(\\"should drop a spread primitive, which copies nothing\\",()=>{expect({a:1}).toEqual({a:1})}),it(\\"should keep a spread whose items would read otherwise inlined\\",()=>{let e=[1,...[2,,3]];expect(1 in e).toBe(!0),expect(2 in e).toBe(!0);let t=0,l={...{get value(){return t++,t}}};expect(Object.getOwnPropertyDescriptor(l,\\"value\\").value).toBe(1),expect(Object.getPrototypeOf({...{__proto__:null}})).toBe(Object.prototype),expect({...\\"ab\\"}).toEqual({0:\\"a\\",1:\\"b\\"})});"`;

