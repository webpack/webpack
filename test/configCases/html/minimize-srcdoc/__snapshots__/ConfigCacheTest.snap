<iframe id=upper srcdoc=\\"<em>up</em>\\"></iframe>
<iframe id=conditional srcdoc=\\"<!--[if IE]><p class=ie>downlevel<![endif]-->\\"></iframe>
<iframe id=bare srcdoc=\\"<p>bare\\" title=after></iframe>
<iframe id=empty srcdoc></iframe>
<iframe id=none src=child.html></iframe>
<div id=not-an-iframe srcdoc=\\"<!-- kept --><p   >div</p>\\"></div>
<svg><iframe id=foreign srcdoc=\\"<!-- kept --><p   >svg</p>\\"></iframe></svg>
