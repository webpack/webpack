  "/*! system colors are stops too */.system{background-image:radial-gradient(Canvas at center,blue)}",
  "/*! valid preludes still lose their default positions */.shape{background-image:radial-gradient(circle,red,blue)}.position-only{background-image:radial-gradient(red,blue)}.size{background-image:repeating-radial-gradient(10px 20px,red,blue 5px)}.rotation{background-image:conic-gradient(from 90deg,red,blue)}.repeating{background-image:repeating-conic-gradient(red,blue 20deg)}",
