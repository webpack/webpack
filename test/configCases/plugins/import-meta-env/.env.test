WEBPACK_DOTENV_VAR=from_dotenv
WEBPACK_DOTTED.KEY=from_dotted_key
WEBPACK_DEEP.NESTED.KEY=from_deep_key
WEBPACK_DASHED-KEY=from_dashed_key
WEBPACK_null_VALUE=expanded_value
WEBPACK_EXPANDED_NULL=${WEBPACK_null_VALUE}
WEBPACK_EXPANDED_DEFAULT=${WEBPACK_MISSING_null_NAME:-fallback_value}
__proto__=from_prototype_key
