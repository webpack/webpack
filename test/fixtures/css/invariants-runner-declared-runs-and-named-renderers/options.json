[
	{
		"mode": "minify",
		"renderEmbeddedSource": "offers"
	},
	{
		"mode": "minify",
		"renderEmbeddedSource": {
			"name": "builtin",
			"options": {
				"svg": true
			}
		}
	},
	{
		"mode": "minify",
		"transforms": {
			"comments": {
				"regexp": "k\\d"
			}
		}
	},
	{
		"print": "cssMinify",
		"svg": true,
		"renderEmbeddedSource": {
			"name": "offers",
