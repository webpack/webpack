		}
	},
	{
		"mode": "minify",
		"visit": {
			"types": [
				"Declaration"
			],
			"fields": [
				"name"
			],
			"exit": false,
			"at": [
				{
					"type": "Declaration",
					"name": "background",
					"do": "replace",
					"with": "color:red"
				}
			]
		}
	},
	{
		"print": "cssMinify",
		"minimizer": {
			"extractComments": {
